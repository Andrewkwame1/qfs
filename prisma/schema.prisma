// QFS — database schema (PostgreSQL via Prisma)
// Money is stored as integer minor units (cents) everywhere — never floats.
// Every wallet change goes through the ledger so totals are auditable.
//
// Money columns are 32-bit `Int` (max 2,147,483,647 cents = $21,474,836.47).
// That ceiling is deliberate: a total beyond it is a bug, not a rounding error,
// and Postgres would throw rather than silently wrap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Unpooled connection for migrations. Hosted Postgres (Neon/Supabase) hands out
  // a pooled URL for the app and a direct URL for DDL, because pgBouncer cannot
  // run `CREATE INDEX` inside a transaction.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  EARNING
  REFERRAL_BONUS
  LOAN
  ADJUSTMENT
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum Movement {
  CREDIT
  DEBIT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  PENDING
  ACTIVE
  REJECTED
  PAID
}

enum CardStatus {
  ACTIVE
  FROZEN
  EXPIRED
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  CLOSED
}

enum MarketType {
  METAL
  STOCK
  CRYPTO
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  country       String     @default("United States")
  avatarUrl     String     @default("/avatars/avatar1.jpg")
  referralCode  String     @unique
  referredById  String?
  referredBy    User?      @relation("Referrals", fields: [referredById], references: [id])
  referred      User[]     @relation("Referrals")
  kycLevel      Int        @default(0)
  memberSince   DateTime   @default(now())
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions         Session[]
  wallets          WalletConnection[]
  walletNonces     WalletNonce[]
  account          Account?
  transactions     Transaction[]
  investments      Investment[]
  loans            Loan[]
  cards            Card[]
  notifications    Notification[]
  deposits         DepositRequest[]
  withdrawals      WithdrawalRequest[]
  referralEarnings ReferralEarning[]     @relation("ReferrerEarnings")
  auditLogs        AuditLog[]            @relation("AuditActions")

  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String   @id @default(cuid())
  userId         String   @unique
  balanceCents   Int      @default(0)
  availableCents Int      @default(0)
  currency       String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]

  @@index([userId])
}

model LedgerEntry {
  id                 String   @id @default(cuid())
  accountId          String
  movement           Movement
  amountCents        Int
  balanceAfterCents  Int
  txId               String?
  tx                 Transaction? @relation(fields: [txId], references: [id], onDelete: SetNull)
  note               String?
  createdAt          DateTime @default(now())
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model Transaction {
  id                 String    @id @default(cuid())
  userId             String
  type               TxType
  amountCents        Int
  feeCents           Int       @default(0)
  currency           String    @default("USD")
  status             TxStatus  @default(COMPLETED)
  method             String?
  reference          String    @unique
  note               String?
  adminNote          String?
  meta               String?   // JSON — plan name, payment details, etc.
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries      LedgerEntry[]
  depositRequest     DepositRequest?       @relation("DepositTx")
  withdrawalRequest  WithdrawalRequest?    @relation("WithdrawalTx")

  @@index([userId, createdAt])
  @@index([type, status])
}

model DepositRequest {
  id           String         @id @default(cuid())
  userId       String
  amountCents  Int
  method       String
  reference    String         @unique // idempotency key
  status       RequestStatus  @default(PENDING)
  walletAddress String?       // verified wallet the funds came from, when crypto
  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?   @relation("DepositTx", fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId String?       @unique

  @@index([status, createdAt])
}

model WithdrawalRequest {
  id           String         @id @default(cuid())
  userId       String
  amountCents  Int
  method       String
  details      String?        // JSON — wallet address or bank details
  reference    String         @unique // idempotency key
  status       RequestStatus  @default(PENDING)
  walletAddress String?       // verified wallet to pay out to, when crypto
  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?   @relation("WithdrawalTx", fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId String?       @unique

  @@index([status, createdAt])
}

model InvestmentPlan {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  minAmountCents Int
  maxAmountCents Int?
  monthlyRoiBps  Int // basis points per month, e.g. 500 = 5%/mo
  termMonths     Int
  isActive       Boolean  @default(true)
  sort           Int      @default(0)
  color          String   @default("lime")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  investments    Investment[]
}

model Investment {
  id            String           @id @default(cuid())
  userId        String
  planId        String
  amountCents   Int
  status        InvestmentStatus @default(ACTIVE)
  startDate     DateTime         @default(now())
  endDate       DateTime?
  paidOutCents  Int              @default(0)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          InvestmentPlan   @relation(fields: [planId], references: [id])
  earnings      ReferralEarning[]

  @@index([userId, status])
  @@index([status])
}

model ReferralEarning {
  id             String     @id @default(cuid())
  referrerId     String
  referredUserId String
  investmentId   String     @unique // one bonus per referred investment
  amountCents    Int
  status         String     @default("PAID")
  createdAt      DateTime   @default(now())
  referrer       User       @relation("ReferrerEarnings", fields: [referrerId], references: [id], onDelete: Cascade)
  investment     Investment @relation(fields: [investmentId], references: [id])

  @@index([referrerId])
}

model Loan {
  id          String     @id @default(cuid())
  userId      String
  type        String
  currency    String     @default("USD")
  amountCents Int
  period      Int        @default(12) // repayment period (months or label index)
  occupation  String?
  aprBps      Int        @default(950)
  status      LoanStatus @default(PENDING)
  dueDate     DateTime?
  decidedById String?
  decidedAt   DateTime?
  adminNote   String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Card {
  id        String     @id @default(cuid())
  userId    String
  brand     String
  last4     String
  expiry    String
  holder    String
  status    CardStatus @default(ACTIVE)
  isDefault Boolean    @default(false)
  color     String     @default("black")
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletNonce {
  id        String   @id @default(cuid())
  userId    String
  nonce     String
  /// The exact text handed to the client to sign. Verifying against this stored
  /// copy is what makes the signature check reproducible byte-for-byte.
  message   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nonce])
  @@index([expiresAt])
}

model WalletConnection {
  id         String   @id @default(cuid())
  userId     String
  address    String // checksummed EVM address
  chainId    Int      @default(1) // 1 = Ethereum mainnet
  label      String   @default("")
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId])
  @@index([address])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Document {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  flagPath  String
  fileUrl   String
  sort      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id        String       @id @default(cuid())
  userName  String
  avatarUrl String       @default("/avatars/avatar1.jpg")
  country   String       @default("")
  rating    Int          @default(5)
  text      String
  status    String       @default("APPROVED") // APPROVED | PENDING | HIDDEN
  sort      Int          @default(0)
  createdAt DateTime     @default(now())
}

model MarketAsset {
  id        String     @id @default(cuid())
  symbol    String     @unique
  name      String
  full      String // sub-label, e.g. "Gold / USD", "Technology"
  type      MarketType
  price     String
  change    String
  direction String     @default("up") // up | down | flat
  color     String     @default("#2b2b3a")
  sort      Int        @default(0)
  isActive  Boolean    @default(true)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  meta       String? // JSON
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActions", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}